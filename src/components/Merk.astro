---
// Nagezet naar hun logo (bron/site/img/r0_Brillen_Bij_U_Thuis.jpg): BRILLEN / BIJ U THUIS in strakke kapitalen, de U rood,
// daaronder "DE OPTICIEN AAN HUIS" in het rood.
import { url } from '../data/site';
interface Props { donker?: boolean }
const { donker = false } = Astro.props;
---
<a href={url('')} class={`inline-flex flex-col font-merk leading-none no-underline ${donker ? 'text-inkt' : 'text-wit'}`}>
  <span class="text-[1.55rem] font-[650] uppercase tracking-[.01em] sm:text-[1.8rem]">Brillen</span>
  <span class="-mt-0.5 text-[1.55rem] font-[650] uppercase tracking-[.01em] sm:text-[1.8rem]">Bij<span class={donker ? 'text-merk' : 'text-merk-licht'}>U</span>thuis</span>
  <span class={`mt-1 text-[.66rem] font-[600] uppercase tracking-[.22em] sm:text-[.74rem] ${donker ? 'text-merk' : 'text-merk-licht'}`}>De opticien aan huis</span>
  <span class="sr-only">, naar de homepage</span>
</a>
