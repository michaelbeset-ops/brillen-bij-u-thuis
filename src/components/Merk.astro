---
// Nagezet naar hun logo (bron/site/img/r0_Brillen_Bij_U_Thuis.jpg): BRILLEN / BIJ U THUIS in strakke kapitalen, de U rood,
// daaronder "DE OPTICIEN AAN HUIS" in het rood.
import { url } from '../data/site';
// klein: compacte versie voor in de zwevende kopbalk.
interface Props { donker?: boolean; klein?: boolean }
const { donker = false, klein = false } = Astro.props;
const g = klein ? 'text-[1.2rem] sm:text-[1.35rem]' : 'text-[1.55rem] sm:text-[1.8rem]';
const k = klein ? 'text-[.55rem] sm:text-[.6rem]' : 'text-[.66rem] sm:text-[.74rem]';
---
<a href={url('')} class={`inline-flex flex-col font-merk leading-none no-underline ${donker ? 'text-inkt' : 'text-wit'}`}>
  <span class={`${g} font-[650] uppercase tracking-[.01em]`}>Brillen</span>
  <span class={`-mt-0.5 ${g} font-[650] uppercase tracking-[.01em]`}>Bij<span class={donker ? 'text-merk' : 'text-merk-licht'}>U</span>thuis</span>
  <span class={`mt-1 ${k} whitespace-nowrap font-[600] uppercase tracking-[.22em] ${donker ? 'text-merk' : 'text-merk-licht'}`}>De opticien aan huis</span>
  <span class="sr-only">, naar de homepage</span>
</a>
