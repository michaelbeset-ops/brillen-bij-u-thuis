---
import { site, url, waHoi, tijden } from '../data/site';
import Merk from './Merk.astro';
import Icoon from './Icoon.astro';
const jaar = new Date().getFullYear();
const thuis = Astro.url.pathname.replace(/\/$/, '') === import.meta.env.BASE_URL.replace(/\/$/, '');
const h = (id: string) => (thuis ? `#${id}` : url(`#${id}`));
const diensten = [['diensten', 'Oogmeting aan huis'], ['diensten', 'Bril op maat'], ['zorgverzekering', 'Teruggave zorgverzekering'], ['vragen', 'Veelgestelde vragen'], ['afspraak', 'Afspraak maken']];
---
<footer class="bg-inkt text-mist">
  <div class="wrap grid gap-x-10 gap-y-10 py-12 md:gap-y-12 text-[1.0625rem] sm:grid-cols-2 md:py-24 lg:grid-cols-12">
    <div class="lg:col-span-4">
      <Merk />
      <p class="mt-6 max-w-xs">De opticien aan huis door {site.werkgebied}. Wij komen naar u toe!</p>
      <a href={site.telHref} class="knop knop-merk num mt-7 hidden min-h-12 px-5 md:inline-flex"><Icoon naam="tel" />{site.tel}</a>
    </div>
    <div class="hidden sm:block lg:col-span-3">
      <p class="font-bold text-wit">Diensten</p>
      <ul class="mt-5 space-y-2.5">
        {diensten.map(([id, t]) => <li><a href={h(id)} class="no-underline transition-colors hover:text-merk-licht">{t}</a></li>)}
      </ul>
    </div>
    <div class="lg:col-span-3">
      <p class="font-bold text-wit">Contact</p>
      <ul class="mt-5 space-y-2.5">
        <li><a href={site.telHref} class="num no-underline hover:text-merk-licht">{site.tel}</a></li>
        <li><a href={waHoi} target="_blank" rel="noopener noreferrer" class="no-underline hover:text-merk-licht">WhatsApp</a></li>
        <li><a href={`mailto:${site.mail}`} class="break-all no-underline hover:text-merk-licht">{site.mail}</a></li>
        <li>Gevestigd in {site.plaats}</li>
      </ul>
    </div>
    <div class="hidden sm:block lg:col-span-2">
      <p class="font-bold text-wit">Bereikbaar</p>
      <ul class="mt-5 space-y-1.5">
        <li>Ma t/m vr</li>
        <li class="num text-wit">09:00 tot 17:00</li>
        <li class="pt-2">Za en zo gesloten</li>
      </ul>
    </div>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-lijn py-7 text-[.9375rem]">
    <p>© {jaar} {site.naam}, {site.plaats} · KvK {site.kvk}</p>
    <p class="flex flex-wrap gap-x-6 gap-y-2"><a href={url('privacy/')} class="no-underline hover:text-wit">Privacy en bedrijfsgegevens</a><span>Geen cookies</span><span>Website door Sitefront</span></p>
  </div>
  <div class="h-16 md:hidden" aria-hidden="true"></div>
</footer>
