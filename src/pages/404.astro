---
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import { site, url } from '../data/site';
---
<Base title={`Pagina niet gevonden | ${site.naam}`} description="Deze pagina bestaat niet (meer)." noindex>
  <Kop thuis={false} />
  <main id="inhoud" class="bg-papier"><div class="wrap pb-28 pt-16 lg:pt-24">
    <p class="eyebrow">Foutje 404</p>
    <h1 class="mt-5 max-w-3xl text-4xl">Deze pagina kunnen we niet vinden.</h1>
    <p class="mt-6 max-w-xl text-xl text-steen">Misschien is de link verouderd. Op de homepage vindt u alles, of bel ons gewoon.</p>
    <div class="mt-9 flex flex-col gap-3 sm:flex-row">
      <a href={url('')} class="knop knop-inkt">Naar de homepage</a>
      <a href={site.telHref} class="knop knop-merk num"><Icoon naam="tel" />Bel {site.tel}</a>
    </div>
  </div></main>
  <Voet />
</Base>
