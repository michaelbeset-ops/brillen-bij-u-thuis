---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import { site, reviews, overPaul, tijden, waHoi, zorg, faq, url } from '../data/site';

// Alleen eigen beeld van brillenbijuthuis.nl. Zie src/assets/BRONNEN.txt.
import ePassen from '../assets/eigen-passen.jpg';
import eMonturen from '../assets/eigen-monturen.jpg';
import eMeting from '../assets/eigen-meting.jpg';
import eMetingBreed from '../assets/eigen-meting-breed.jpg';
import ePasglazen from '../assets/eigen-pasglazen.jpg';
import pAafje from '../assets/p-aafje.png';
import pEnvida from '../assets/p-envida.png';
import pThebe from '../assets/p-thebe.png';
import pMeander from '../assets/p-meander.png';

// Opbouw (verbeterplan 14-10-2026): hero, vertrouwensstrook, diensten, maak kennis met Paul, werkwijze, reviews,
// vragen, afspraak en contact. Elk onderwerp staat er een keer; teksten uit hun eigen site, folder en Google-reviews.
const diensten = [
  { t: 'Oogmeting aan huis', d: 'Een oogmeting is kosteloos, net als ons advies wat daar uit volgt.', l: ['Gemeten met een pasbril, net als bij de oogarts', 'Door een gediplomeerde opticien'], src: ePasglazen, pos: 'object-[50%_22%]', alt: 'De kist met pasglazen die de opticien meeneemt' },
  { t: 'Een bril op maat', d: 'In alle categorieën bieden wij u een ruime keuze in onze monturen.', l: ['Vertebril of leesbril', 'Bifocale of multifocale bril', 'Zonnebril'], src: eMonturen, pos: 'object-[50%_60%]', alt: 'Lade met monturen die de opticien meeneemt' },
];

const strook = [
  { i: 'vink', t: 'Gediplomeerd', d: 'opticien, met nascholing' },
  { i: 'vink', t: 'Kosteloos', d: 'oogmeting en advies' },
  { i: 'polis', t: 'Declarabel', d: 'bij uw zorgverzekering' },
  { i: 'pin', t: 'Aan huis', d: 'of in het verzorgingshuis' },
];

const stappen = [
  ['Bel, app of mail', 'Voor een afspraak met één van onze gediplomeerde opticiens.'],
  ['Oogmeting bij u thuis', 'Kosteloos, met een pasbril. Het advies dat daaruit volgt ook.'],
  ['Bril uitkiezen', 'Uit een ruime keuze in monturen, in alle categorieën.'],
  ['Declareren', 'Recht op een teruggave? Dien onze factuur in bij uw zorgverzekering.'],
];

const partners = [
  { src: pAafje, alt: 'Allemaal Aafje' },
  { src: pEnvida, alt: 'Envida ledenservice' },
  { src: pThebe, alt: 'Thebe extra' },
  { src: pMeander, alt: 'Meander eXtra' },
];

const sterren = [1, 2, 3, 4, 5];
---
<Base title="Opticien aan huis, oogmeting gratis | Brillen bij u thuis" description="Opticien aan huis in midden en zuid Nederland. Gratis oogmeting en advies bij u thuis. Factuur in te dienen bij uw zorgverzekering. Bel 06 555 77 424." schema>
  <div class="relative">
    <Kop />

    {/* 1. Hero, op elke schermbreedte dezelfde boodschap (4A): hun eigen foto van Paul die meet met de pasbril,
        5,0 op Google en de officiele partners. Mobiel: foto boven, geen knoppen (de belbalk onderin doet dat).
        Vanaf 1024px: links tekst, rechts de foto over de volle hoogte. */}
    <section class="bg-inkt text-wit lg:grid lg:min-h-[100svh] lg:grid-cols-2" aria-labelledby="inhoud">
      <div class="relative h-[calc(46svh+6rem)] min-h-[25rem] max-h-[40rem] pt-24 md:h-[52svh] md:max-h-[34rem] md:min-h-[19rem] md:pt-0 lg:order-2 lg:h-auto lg:max-h-none">
        {/* Twee uitsneden: breed voor mobiel, staand voor tablet en desktop. sizes 1px waar hij verborgen is, dan pakt de browser het kleinste bestand. */}
        <Image src={eMetingBreed} alt="Paul meet met een pasbril bij een klant aan tafel, met de kist pasglazen ervoor" widths={[480, 640, 800, 1100]} sizes="(min-width: 768px) 1px, 100vw" loading="eager" fetchpriority="high" quality={60} class="h-full w-full object-cover object-[45%_0%] md:hidden" />
        <Image src={eMeting} alt="Paul meet met een pasbril bij een klant aan tafel, met de kist pasglazen ervoor" widths={[640, 1000, 1500]} sizes="(min-width: 1024px) 50vw, (min-width: 768px) 100vw, 1px" loading="eager" quality={62} class="hidden h-full w-full object-cover object-[45%_8%] md:block lg:absolute lg:inset-0 lg:object-[45%_22%]" />
        <div class="absolute inset-x-0 top-0 hidden h-32 bg-[linear-gradient(180deg,#1d0a2a,#1d0a2a00)] md:block lg:h-48 lg:bg-[linear-gradient(180deg,#1d0a2af2_0%,#1d0a2ab3_45%,#1d0a2a00_100%)]" aria-hidden="true"></div>
        <div class="absolute inset-x-0 bottom-0 h-16 bg-[linear-gradient(0deg,#1d0a2a,#1d0a2a00)] lg:hidden" aria-hidden="true"></div>
        {/* Desktop: wat een klant over Paul zegt, op de foto zelf. */}
        <figure class="absolute bottom-10 left-10 hidden max-w-[22rem] rounded-[16px] bg-wit p-5 text-inkt shadow-[0_14px_40px_#1d0a2a59] xl:block">
          <div class="flex items-center gap-2"><span class="flex text-merk" aria-hidden="true">{sterren.map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span><span class="text-[.9375rem] text-steen">Google review</span></div>
          <blockquote class="mt-2 text-lg font-bold leading-snug">“Paul Jansen werkt met aandacht en is rustig en vriendelijk.”</blockquote>
          <figcaption class="mt-2 text-[.9375rem] text-steen">{overPaul[0].naam}, over de oogmeting bij haar moeder van 103</figcaption>
        </figure>
      </div>
      <div class="wrap relative -mt-2 pb-12 lg:order-1 lg:mt-0 lg:flex lg:max-w-none lg:flex-col lg:justify-center lg:pb-14 lg:pl-[max(2.5rem,calc((100vw-80rem)/2+2.5rem))] lg:pr-14 lg:pt-32 xl:pt-36">
        <h1 id="inhoud"><span class="eyebrow eyebrow-licht block">Gediplomeerde opticien aan huis</span><span class="mt-3 block text-[clamp(2.3rem,2.9vw+1rem,3.9rem)]">Gemeten met een pasbril, net als bij de <span class="text-merk-licht">oogarts.</span></span></h1>
        <p class="mt-4 max-w-lg text-xl leading-relaxed text-wit/90 lg:mt-6">Gewoon bij u thuis, door midden en zuid Nederland. Oogmeting en advies kosteloos.</p>
        <div class="mt-8 hidden gap-3 md:flex md:flex-wrap">
          <a href={site.telHref} class="knop knop-merk num"><Icoon naam="tel" />Bel {site.tel}</a>
          <a href="#afspraak" class="knop knop-wit"><Icoon naam="wa" />Afspraak maken</a>
        </div>
        <a href="#reviews" class="mt-5 flex w-fit items-center gap-2 text-[1.0625rem] text-wit no-underline md:mt-7"><span class="flex text-merk-licht" aria-hidden="true">{sterren.map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span><b class="num">{site.google.score}</b><span class="whitespace-nowrap text-mist">uit {site.google.aantal} Google-reviews</span></a>
        <p class="mt-7 text-[.9375rem] font-bold text-mist lg:mt-8">Officieel samenwerkingspartner van</p>
        <ul class="mt-3 grid max-w-md grid-cols-4 gap-2 lg:gap-3">
          {partners.map((p) => <li class="grid h-14 place-items-center rounded-[10px] bg-wit p-1.5 lg:h-16"><Image src={p.src} alt={p.alt} widths={[200]} sizes="100px" class="max-h-10 w-auto object-contain" /></li>)}
        </ul>
      </div>
    </section>
  </div>

  <main>
    {/* 2. Vertrouwensstrook: de vier harde punten op een rij, in een oogopslag. */}
    <section class="border-b border-lijn-licht bg-wit" aria-label="Waarom Brillen bij u thuis">
      <ul class="strookrij py-5 md:py-8" tabindex="0" aria-label="Waarom Brillen bij u thuis, veeg opzij voor meer">
        {strook.map((s) => (
          <li class="flex min-w-0 items-center gap-3 rounded-[14px] border border-lijn-licht bg-papier px-4 py-3 md:border-0 md:bg-transparent md:p-0">
            <span class="grid h-10 w-10 flex-none place-items-center rounded-full bg-[#fdeef2] text-merk md:h-11 md:w-11"><Icoon naam={s.i} class="h-5 w-5" /></span>
            <span class="min-w-0 text-[1rem] leading-snug md:text-[1.0625rem]"><b class="block text-[1.0625rem] md:text-lg">{s.t}</b><span class="text-steen">{s.d}</span></span>
          </li>
        ))}
      </ul>
    </section>

    {/* 3. Diensten: twee fotokaarten en de zorgverzekering, die hier volledig wordt uitgelegd. Op mobiel een veegrij. */}
    <section id="diensten" class="bg-papier py-14 md:py-20 lg:py-24" aria-labelledby="t-diensten">
      <div class="wrap">
        <div class="rijs max-w-3xl">
          <p class="eyebrow">Diensten</p>
          <h2 id="t-diensten" class="mt-3 text-4xl">Van oogmeting tot bril op uw neus.</h2>
        </div>
        <ul id="r-diensten" class="rail rijs mt-8 md:grid-cols-2 lg:mt-10 lg:grid-cols-3" tabindex="0" aria-label="Diensten, veeg opzij voor meer">
          {diensten.map((v) => (
            <li>
              <article class="kaart group flex h-full flex-col overflow-hidden">
                <Image src={v.src} alt={v.alt} widths={[420, 640, 860]} sizes="(min-width: 1024px) 400px, (min-width: 768px) 46vw, 85vw" quality={70} class={`aspect-[3/2] w-full object-cover ${v.pos}`} />
                <div class="flex flex-1 flex-col p-6 sm:p-7">
                  <h3 class="text-[clamp(1.5rem,.8vw+1.25rem,1.85rem)]">{v.t}</h3>
                  <p class="mt-3 text-lg text-steen">{v.d}</p>
                  <ul class="mt-5 space-y-2 border-t border-lijn-licht pt-5">
                    {v.l.map((x) => <li class="flex gap-3"><Icoon naam="vink" class="mt-1 h-5 w-5 flex-none text-merk" />{x}</li>)}
                  </ul>
                  <a href="#afspraak" class="mt-auto inline-flex items-center gap-2 pt-7 text-lg font-extrabold text-merk no-underline transition-colors hover:text-merk-diep">Afspraak maken<Icoon naam="pijl" class="h-5 w-5 transition-transform duration-300 group-hover:translate-x-1" /></a>
                </div>
              </article>
            </li>
          ))}
          <li id="zorgverzekering" class="scroll-mt-6 md:col-span-2 lg:col-span-1">
            <article class="flex h-full flex-col rounded-[14px] bg-merk p-6 text-wit sm:p-7">
              <span class="grid h-14 w-14 place-items-center rounded-full bg-wit text-merk"><Icoon naam="polis" class="h-8 w-8" /></span>
              <h3 class="mt-6 text-[clamp(1.5rem,.8vw+1.25rem,1.85rem)]">Teruggave zorg&shy;verzekering</h3>
              <p class="mt-3 text-lg leading-relaxed">{zorg.kort}</p>
              <ol class="mt-5 space-y-3 border-t border-wit/30 pt-5">
                <li class="flex gap-3"><span class="grid h-7 w-7 flex-none place-items-center rounded-full bg-wit text-[.9375rem] font-[800] text-merk">1</span>U dient de factuur van ons in bij uw zorgverzekering.</li>
                <li class="flex gap-3"><span class="grid h-7 w-7 flex-none place-items-center rounded-full bg-wit text-[.9375rem] font-[800] text-merk">2</span>Zij betalen uit op de rekening waar de premie van afgaat.</li>
              </ol>
              <p class="mt-auto pt-6 text-[1rem] text-wit/90">Of u recht heeft op een teruggave, en hoeveel, staat in uw polis.</p>
            </article>
          </li>
        </ul>
        <div class="rail-nav" data-rail="r-diensten">
          <p class="num text-steen" aria-hidden="true"><b class="text-inkt" data-tel>1</b> van 3 · veeg opzij</p>
          <div class="flex gap-3">
            <button type="button" class="pijlknop" data-vorige aria-controls="r-diensten" aria-label="Vorige dienst"><Icoon naam="pijl" class="h-6 w-6 rotate-180" /></button>
            <button type="button" class="pijlknop" data-volgende aria-controls="r-diensten" aria-label="Volgende dienst"><Icoon naam="pijl" class="h-6 w-6" /></button>
          </div>
        </div>
      </div>
    </section>

    {/* 4. Maak kennis: Paul centraal, met een grote eigen foto en wat klanten letterlijk over hem zeggen. Tekst van hun pagina Over ons. */}
    <section id="over" class="bg-inkt py-14 text-wit md:py-20 lg:py-24" aria-labelledby="t-over">
      <div class="wrap grid grid-cols-[minmax(0,1fr)] items-center gap-y-10 lg:grid-cols-12 lg:gap-x-14">
        <figure class="rijs lg:col-span-6">
          <Image src={ePassen} alt="Paul past bij een klant thuis een montuur, met de lade monturen ervoor" widths={[600, 900, 1300]} sizes="(min-width: 1024px) 46vw, 100vw" quality={70} class="aspect-[4/3] w-full rounded-[18px] object-cover object-[45%_30%] lg:aspect-[5/5]" />
        </figure>
        <div class="lg:col-span-6">
          <p class="rijs eyebrow eyebrow-licht">Maak kennis</p>
          <h2 id="t-over" class="rijs mt-3 text-4xl">Paul komt bij u <span class="text-merk-licht">langs.</span></h2>
          <p class="rijs mt-5 text-xl leading-relaxed text-wit/90 [--d:.06s]">Het ogenpaar is misschien wel ons belangrijkste zintuig. Daarom wordt een oogmeting bij Brillen bij u thuis alleen gedaan door een gediplomeerde opticien. Door nascholing houden we de kennis altijd up to date.</p>
          <p class="rijs mt-4 text-xl leading-relaxed text-wit/90 [--d:.08s]">Wij meten, net als de oogarts, "ouderwets" met een pasbril. Zo krijgt u een hele natuurgetrouwe manier van kijken.</p>
          <ul class="rijs mt-8 grid gap-3 sm:grid-cols-2 [--d:.12s]">
            {overPaul.map((r) => (
              <li>
                <figure class="h-full rounded-[14px] border border-lijn bg-inkt-2 p-5">
                  <div class="flex text-merk-licht" role="img" aria-label="5 sterren">{sterren.map(() => <Icoon naam="ster" class="h-4 w-4" />)}</div>
                  <blockquote class="mt-3 leading-relaxed">“{r.tekst}”</blockquote>
                  <figcaption class="mt-3 text-[.9375rem] text-mist">{r.naam}, Google review</figcaption>
                </figure>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    {/* 5. Werkwijze: vier korte stappen naast elkaar (mobiel onder elkaar, het is kort genoeg), met de knop direct eronder. */}
    <section id="werkwijze" class="bg-wit py-14 md:py-20 lg:py-24" aria-labelledby="t-werk">
      <div class="wrap">
        <div class="rijs max-w-3xl">
          <p class="eyebrow">Werkwijze</p>
          <h2 id="t-werk" class="mt-3 text-4xl">Zo gaat het.</h2>
        </div>
        <ol class="rijs mt-8 grid gap-x-8 gap-y-6 sm:grid-cols-2 lg:mt-10 lg:grid-cols-4">
          {stappen.map(([t, dd], i) => (
            <li class="flex gap-4 border-t-2 border-merk pt-5 lg:block">
              <span class="stap-nr num flex-none text-[2.4rem]" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <div class="lg:mt-3"><h3 class="text-[1.375rem] leading-tight">{t}</h3><p class="mt-2 text-lg text-steen">{dd}</p></div>
            </li>
          ))}
        </ol>
        <div class="rijs mt-10 flex flex-wrap gap-3">
          <a href="#afspraak" class="knop knop-merk">Afspraak maken<Icoon naam="pijl" /></a>
          <a href={site.telHref} class="knop knop-rand num hidden md:inline-flex"><Icoon naam="tel" />Bel {site.tel}</a>
        </div>
      </div>
    </section>

    {/* 6. Reviews: een rij die opzij schuift. */}
    <section id="reviews" class="bg-papier py-14 md:py-20 lg:py-24" aria-labelledby="t-rev">
      <div class="wrap">
        <div class="flex flex-wrap items-end justify-between gap-6">
          <div class="rijs">
            <p class="eyebrow">Reviews</p>
            <h2 id="t-rev" class="mt-3 text-4xl">Wat klanten zeggen.</h2>
          </div>
          <a href={site.reviews} target="_blank" rel="noopener noreferrer" class="rijs kaart flex items-center gap-4 px-5 py-4 no-underline transition-shadow hover:shadow-[0_6px_18px_#1d0a2a1f] [--d:.06s]">
            <Icoon naam="g" class="h-9 w-9 flex-none" />
            <span>
              <span class="flex items-center gap-2"><b class="num text-2xl font-[800] leading-none text-inkt">{site.google.score}</b><span class="flex text-merk" aria-hidden="true">{sterren.map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span></span>
              <span class="mt-1 block text-steen">{site.google.aantal} reviews op Google</span>
            </span>
          </a>
        </div>
        <ul id="r-rev" class="rail rail-altijd rijs mt-8 lg:mt-10" tabindex="0" aria-label="Reviews, veeg opzij voor meer">
          {reviews.map((r) => (
            <li>
              <figure class="kaart flex h-full flex-col p-6 sm:p-7">
                <div class="flex gap-0.5 text-merk" role="img" aria-label="5 sterren">{sterren.map(() => <Icoon naam="ster" class="h-5 w-5" />)}</div>
                <blockquote class="mt-4 flex-1 text-lg leading-relaxed">“{r.tekst}”</blockquote>
                <figcaption class="mt-5 flex items-center gap-3 border-t border-lijn-licht pt-4">
                  <span class="grid h-10 w-10 flex-none place-items-center rounded-full bg-papier-2 font-bold">{r.naam[0]}</span>
                  <span><b class="block">{r.naam}</b><span class="text-steen">Google review</span></span>
                </figcaption>
              </figure>
            </li>
          ))}
        </ul>
        <div class="rail-nav rail-altijd" data-rail="r-rev">
          <p class="num text-steen" aria-hidden="true"><b class="text-inkt" data-tel>1</b> van {reviews.length} · schuif opzij</p>
          <div class="flex gap-3">
            <button type="button" class="pijlknop" data-vorige aria-controls="r-rev" aria-label="Vorige review"><Icoon naam="pijl" class="h-6 w-6 rotate-180" /></button>
            <button type="button" class="pijlknop" data-volgende aria-controls="r-rev" aria-label="Volgende review"><Icoon naam="pijl" class="h-6 w-6" /></button>
          </div>
        </div>
      </div>
    </section>

    {/* 7. Veelgestelde vragen: alleen antwoorden uit hun eigen teksten. Zelfde inhoud staat als FAQPage in de JSON-LD en in llms.txt. */}
    <section id="vragen" class="bg-wit py-14 md:py-20 lg:py-24" aria-labelledby="t-vragen">
      <div class="wrap grid gap-y-8 lg:grid-cols-12 lg:gap-x-16">
        <div class="rijs lg:col-span-4">
          <p class="eyebrow">Vragen</p>
          <h2 id="t-vragen" class="mt-3 text-4xl">Goed om te weten.</h2>
        </div>
        <div class="rijs space-y-3 lg:col-span-8 [--d:.06s]">
          {faq.map(([v, a], i) => (
            <details class="vraag" open={i === 1}>
              <summary>{v}<span class="vraag-plus" aria-hidden="true"></span></summary>
              <p class="px-5 pb-6 text-lg leading-relaxed text-steen sm:px-7">{a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    {/* 8. Afspraak en contact in een blok: kort formulier dat een WhatsApp- of mailbericht klaarzet, met daarnaast contact en tijden. */}
    <section id="afspraak" class="bg-papier-2 py-14 md:py-20 lg:py-24" aria-labelledby="t-afspraak">
      <div class="wrap">
        <div class="rijs max-w-3xl">
          <p class="eyebrow">Afspraak aan huis</p>
          <h2 id="t-afspraak" class="mt-3 text-4xl">Waar mogen we langskomen?</h2>
          <p class="mt-4 max-w-2xl text-xl text-steen">Kies wat past. U ziet meteen het bericht en verstuurt het zelf, via WhatsApp of e-mail. Of bel ons gewoon.</p>
        </div>

        <div class="mt-8 grid grid-cols-[minmax(0,1fr)] gap-6 lg:mt-10 lg:grid-cols-12 lg:gap-8">
          <form class="kaart min-w-0 p-5 sm:p-8 lg:col-span-7" data-afspraak>
            <div class="space-y-7">
              <fieldset>
                <legend class="veld-label"><span class="text-merk">1.</span> Voor wie is de afspraak?</legend>
                <div class="grid gap-3 sm:grid-cols-3">
                  <label class="keuze"><input type="radio" name="voor" value="mij" checked />Voor mijzelf</label>
                  <label class="keuze"><input type="radio" name="voor" value="ouder" />Voor mijn vader of moeder</label>
                  <label class="keuze"><input type="radio" name="voor" value="ander" />Voor iemand anders</label>
                </div>
              </fieldset>
              <fieldset>
                <legend class="veld-label"><span class="text-merk">2.</span> Waarvoor?</legend>
                <div class="grid gap-3 min-[375px]:grid-cols-2">
                  <label class="keuze"><input type="radio" name="wat" value="een oogmeting" checked />Oogmeting</label>
                  <label class="keuze"><input type="radio" name="wat" value="een nieuwe bril" />Nieuwe bril</label>
                  <label class="keuze"><input type="radio" name="wat" value="reparatie van een bril" />Reparatie</label>
                  <label class="keuze"><input type="radio" name="wat" value="een zonnebril" />Zonnebril</label>
                </div>
              </fieldset>
              <div class="grid gap-7 sm:grid-cols-2 sm:gap-4">
                <div>
                  <label for="plaats" class="veld-label"><span class="text-merk">3.</span> In welke plaats?</label>
                  <input id="plaats" name="plaats" class="veld" autocomplete="address-level2" placeholder="Bijvoorbeeld Tilburg" />
                </div>
                <div>
                  <label for="naam" class="veld-label">Uw naam <span class="font-normal text-steen">(mag leeg)</span></label>
                  <input id="naam" name="naam" class="veld" autocomplete="name" />
                </div>
              </div>
            </div>
            <div class="mt-8 rounded-[12px] bg-inkt p-5 text-wit sm:p-6">
              <p class="font-bold text-mist">Uw bericht</p>
              <p class="mt-3 whitespace-pre-line text-[1.125rem] leading-relaxed" data-voorbeeld aria-live="polite"></p>
              <div class="mt-5 grid gap-3 sm:grid-cols-2">
                <a href={waHoi} class="knop knop-groen w-full" data-verstuur target="_blank" rel="noopener noreferrer"><Icoon naam="wa" />Via WhatsApp</a>
                <a href={`mailto:${site.mail}`} class="knop knop-wit w-full" data-mail>Per e-mail</a>
              </div>
            </div>
            <p class="mt-4 text-[1rem] text-steen">Dit formulier verstuurt zelf niets en slaat niets op. Lees ook onze <a href={url('privacy/')} class="link font-bold text-inkt">privacyverklaring</a>.</p>
          </form>

          <div id="contact" class="scroll-mt-6 lg:col-span-5">
            <div class="kaart overflow-hidden">
              <div class="border-b border-lijn-licht p-6">
                <h3 class="text-2xl">Liever bellen?</h3>
                <a href={site.telHref} class="num mt-2 block text-[clamp(1.9rem,2vw+1.2rem,2.5rem)] font-[800] leading-tight text-inkt no-underline hover:text-merk">{site.tel}</a>
                <p class="mt-2 text-steen">Ook voor <a href={waHoi} target="_blank" rel="noopener noreferrer" class="link font-bold text-inkt">WhatsApp</a>. Of mail naar:</p>
                <p class="mt-1"><a href={`mailto:${site.mail}`} class="link font-bold text-inkt">{site.mail}</a></p>
              </div>
              <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1 px-6 pb-2 pt-5">
                <p class="text-lg font-extrabold">Openingstijden</p>
                <p class="flex items-center gap-2 text-[1rem] font-bold" data-status><span class="h-3 w-3 rounded-full bg-papier-3" data-stip></span><span data-status-tekst>Ma t/m vr</span></p>
              </div>
              <table class="w-full sm:text-lg">
                <caption class="sr-only">Openingstijden</caption>
                <tbody>
                  {tijden.map((t) => (
                    <tr class="data-[vandaag]:bg-[#fdeef2] data-[vandaag]:font-extrabold" data-dag={t.nr}>
                      <th scope="row" class="py-2 pl-5 pr-2 text-left font-[inherit] sm:pl-6">{t.dag}</th>
                      <td class="num whitespace-nowrap py-2 pl-2 pr-5 text-right sm:pr-6">{t.open ? `0${t.open[0]}:00 tot ${t.open[1]}:00` : 'Gesloten'}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
              <p class="mt-3 flex gap-3 border-t border-lijn-licht p-6"><Icoon naam="pin" class="mt-1 h-6 w-6 flex-none text-merk" /><span><b class="block">Wij komen bij u thuis</b><span class="text-steen">Door {site.werkgebied}. Gevestigd in {site.plaats}.</span></span></p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Voet />
</Base>

<script>
  import { site } from '../data/site';
  // Afspraakkaart -> vooraf ingevuld WhatsApp-bericht.
  const f = document.querySelector<HTMLFormElement>('[data-afspraak]');
  const vb = document.querySelector<HTMLElement>('[data-voorbeeld]');
  const knop = document.querySelector<HTMLAnchorElement>('[data-verstuur]');
  const mail = document.querySelector<HTMLAnchorElement>('[data-mail]');
  if (f && vb && knop) {
    const tekst = () => {
      const d = new FormData(f);
      const voor = String(d.get('voor'));
      const wat = String(d.get('wat') || 'een afspraak');
      const plaats = String(d.get('plaats') || '').trim();
      const dagdeel = String(d.get('dagdeel') || '');
      const naam = String(d.get('naam') || '').trim();
      const wie = voor === 'ouder' ? ' voor mijn vader of moeder' : voor === 'ander' ? ' voor iemand anders' : '';
      const r = [`Hallo Brillen bij u thuis, ik wil graag een afspraak aan huis${wie}, voor ${wat}.`];
      if (plaats) r.push(`Plaats: ${plaats}.`);
      if (dagdeel) r.push(`Het liefst in de ${dagdeel}.`);
      if (naam) r.push(`Groet, ${naam}`);
      return r.join('\n');
    };
    const zet = () => { const t = tekst(); vb.textContent = t; knop.href = `${site.wa}?text=${encodeURIComponent(t)}`; if (mail) mail.href = `mailto:${site.mail}?subject=${encodeURIComponent('Afspraak aan huis')}&body=${encodeURIComponent(t)}`; };
    f.addEventListener('input', zet); f.addEventListener('change', zet);
    f.addEventListener('submit', (e) => e.preventDefault());
    zet();
  }
  // Veegrijen: teller bijwerken en pijlknoppen voor wie niet weet dat je kunt vegen.
  document.querySelectorAll<HTMLElement>('[data-rail]').forEach((nav) => {
    const rij = document.getElementById(nav.dataset.rail!);
    if (!rij) return;
    const items = [...rij.children] as HTMLElement[];
    const tel = nav.querySelector('[data-tel]');
    const vorige = nav.querySelector<HTMLButtonElement>('[data-vorige]');
    const volgende = nav.querySelector<HTMLButtonElement>('[data-volgende]');
    const huidig = () => {
      const x = rij.scrollLeft + rij.clientWidth * 0.3;
      let n = 0; items.forEach((el, i) => { if (el.offsetLeft - rij.offsetLeft <= x) n = i; });
      return rij.scrollLeft + rij.clientWidth >= rij.scrollWidth - 4 ? items.length - 1 : n;
    };
    const ga = (i: number) => {
      const el = items[Math.max(0, Math.min(items.length - 1, i))];
      const glad = !matchMedia('(prefers-reduced-motion: reduce)').matches;
      rij.scrollTo({ left: el.offsetLeft - rij.offsetLeft - parseFloat(getComputedStyle(rij).scrollPaddingLeft || '0'), behavior: glad ? 'smooth' : 'auto' });
    };
    const zet = () => {
      const n = huidig();
      if (tel) tel.textContent = String(n + 1);
      if (vorige) vorige.disabled = rij.scrollLeft < 4;
      if (volgende) volgende.disabled = n === items.length - 1;
    };
    vorige?.addEventListener('click', () => ga(huidig() - 1));
    volgende?.addEventListener('click', () => ga(huidig() + 1));
    rij.addEventListener('scroll', () => requestAnimationFrame(zet), { passive: true });
    zet();
  });

  // Vandaag in de tijdentabel + nu bereikbaar.
  const nu = new Date(); const dag = nu.getDay(); const uur = nu.getHours() + nu.getMinutes() / 60;
  document.querySelector(`[data-dag="${dag}"]`)?.setAttribute('data-vandaag', '');
  const open = dag >= 1 && dag <= 5 && uur >= 9 && uur < 17;
  const st = document.querySelector('[data-status-tekst]'); const stip = document.querySelector<HTMLElement>('[data-stip]');
  if (st && stip) { st.textContent = open ? 'Nu bereikbaar' : 'Nu gesloten'; stip.style.background = open ? '#1a7f4b' : '#c8103c'; }
</script>
