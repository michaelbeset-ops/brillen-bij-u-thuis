---
// TIJDELIJK (14-10-2026): zes hero-varianten om uit te kiezen. Niet deployen; na de keuze naar tools/ verplaatsen.
// Alleen echte feiten: hun site, hun folder, Google (5,0 uit 40) en letterlijke reviews.
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Kop from '../../components/Kop.astro';
import Icoon from '../../components/Icoon.astro';
import { site, reviews } from '../../data/site';
import sHero from '../../assets/s-hero.jpg';
import ePassen from '../../assets/eigen-passen.jpg';
import eMeting from '../../assets/eigen-meting.jpg';
import ePasglazen from '../../assets/eigen-pasglazen.jpg';
import eMonturen from '../../assets/eigen-monturen.jpg';
import ePasbril from '../../assets/eigen-pasbril.jpg';
import pAafje from '../../assets/p-aafje.png';
import pEnvida from '../../assets/p-envida.png';
import pThebe from '../../assets/p-thebe.png';
import pMeander from '../../assets/p-meander.png';

export function getStaticPaths() { return [1, 2, 3, 4, 5, 6].map((n) => ({ params: { n: String(n) } })); }
const n = Number(Astro.params.n);
const licht = [1, 2, 5, 6].includes(n);
const sterren = [1, 2, 3, 4, 5];
const partners = [
  { src: pAafje, alt: 'Allemaal Aafje', h: 'h-11' },
  { src: pEnvida, alt: 'Envida ledenservice', h: 'h-9' },
  { src: pThebe, alt: 'Thebe extra', h: 'h-8' },
  { src: pMeander, alt: 'Meander eXtra', h: 'h-8' },
];
const ans = reviews[0];
---
<Base title={`Hero ${n}`} description="Hero-variant" noindex>
  <div class="relative">
    <Kop licht={licht} />

    {n === 1 && (
      /* 1. Licht en warm: Paul aan het werk, een echte review erbij, partners eronder. */
      <section class="bg-papier pb-14 pt-32 md:pt-44" aria-labelledby="inhoud">
        <div class="wrap grid grid-cols-[minmax(0,1fr)] items-center gap-y-12 lg:grid-cols-12 lg:gap-x-14">
          <div class="lg:col-span-6">
            <p class="eyebrow">Gediplomeerde opticien aan huis</p>
            <h1 id="inhoud" class="mt-4 text-[clamp(2.5rem,4.4vw+1rem,4.6rem)]">Een nieuwe bril, gewoon bij u <span class="text-merk">thuis.</span></h1>
            <p class="mt-6 max-w-xl text-xl leading-relaxed text-steen">Wij komen bij u thuis, door midden en zuid Nederland. Oogmeting en advies kosteloos.</p>
            <div class="mt-8 grid grid-cols-2 gap-3 sm:flex">
              <a href={site.telHref} class="knop knop-merk num !px-4 sm:!px-7"><Icoon naam="tel" /><span class="sm:hidden">Bellen</span><span class="hidden sm:inline">Bel {site.tel}</span></a>
              <a href="#afspraak" class="knop knop-rand !px-4 sm:!px-7"><Icoon naam="wa" class="text-[#1a7f4b]" />WhatsApp</a>
            </div>
            <ul class="mt-8 grid gap-3 text-lg sm:grid-cols-2">
              <li class="flex items-center gap-3"><span class="flex text-merk">{sterren.map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span><b class="num">5,0</b> op Google</li>
              <li class="flex items-center gap-3"><Icoon naam="vink" class="h-5 w-5 text-merk" />Oogmeting kosteloos</li>
              <li class="flex items-center gap-3"><Icoon naam="polis" class="h-5 w-5 text-merk" />Via uw zorgverzekering</li>
              <li class="flex items-center gap-3"><Icoon naam="vink" class="h-5 w-5 text-merk" />Gemeten met een pasbril</li>
            </ul>
          </div>
          <div class="relative lg:col-span-6">
            <Image src={ePassen} alt="De opticien past bij een klant thuis een montuur" widths={[600, 900, 1300]} sizes="(min-width:1024px) 46vw, 100vw" loading="eager" class="aspect-[4/3] w-full rounded-[22px] object-cover object-[45%_30%] lg:aspect-[5/5]" />
            <figure class="relative -mt-14 ml-4 mr-10 rounded-[16px] bg-wit p-5 shadow-[0_10px_30px_#1d0a2a24] sm:absolute sm:-bottom-8 sm:-left-8 sm:m-0 sm:max-w-[22rem]">
              <div class="flex text-merk">{sterren.map(() => <Icoon naam="ster" class="h-4 w-4" />)}</div>
              <blockquote class="mt-2 text-lg font-bold leading-snug">“Zeer vriendelijk en kundig geholpen!”</blockquote>
              <figcaption class="mt-2 text-steen">{ans.naam}, Google review</figcaption>
            </figure>
          </div>
        </div>
        <div class="wrap mt-16 flex flex-wrap items-center gap-x-10 gap-y-5 border-t border-lijn-licht pt-8">
          <p class="font-bold">Officieel samenwerkingspartner van</p>
          {partners.map((p) => <Image src={p.src} alt={p.alt} widths={[200]} sizes="120px" class={`${p.h} w-auto`} />)}
        </div>
      </section>
    )}

    {n === 2 && (
      /* 2. De klant aan het woord: een echte review is de blikvanger. */
      <section class="bg-wit pb-16 pt-32 md:pt-40" aria-labelledby="inhoud">
        <div class="wrap grid grid-cols-[minmax(0,1fr)] gap-y-12 lg:grid-cols-12 lg:gap-x-16">
          <div class="lg:col-span-7">
            <h1 id="inhoud" class="eyebrow">Opticien aan huis in midden en zuid Nederland</h1>
            <div class="mt-6 flex items-center gap-3"><span class="flex text-merk">{sterren.map(() => <Icoon naam="ster" class="h-6 w-6" />)}</span><span class="text-lg"><b class="num">5,0</b> uit 40 Google-reviews</span></div>
            <blockquote class="mt-6 text-[clamp(2rem,2.2vw+1rem,3.3rem)] font-[800] leading-[1.08] tracking-[-.025em]"><span class="text-merk">“</span>Zeer vriendelijk en kundig geholpen! Fijn dat mijn moeder in haar relaxstoel kon blijven zitten.<span class="text-merk">”</span></blockquote>
            <p class="mt-5 text-lg text-steen">{ans.naam}, Google review</p>
            <p class="mt-6 max-w-xl text-xl leading-relaxed">Oogmeting en een nieuwe bril bij u thuis, door een gediplomeerde opticien. Oogmeting en advies kosteloos.</p>
            <div class="mt-8 grid grid-cols-2 gap-3 sm:flex">
              <a href={site.telHref} class="knop knop-merk num !px-4 sm:!px-7"><Icoon naam="tel" /><span class="sm:hidden">Bellen</span><span class="hidden sm:inline">Bel {site.tel}</span></a>
              <a href="#afspraak" class="knop knop-inkt !px-4 sm:!px-7"><Icoon naam="wa" />WhatsApp</a>
            </div>
          </div>
          <div class="grid grid-cols-5 gap-4 lg:col-span-5 lg:h-[31rem] lg:self-center">
            <Image src={eMeting} alt="De opticien meet met een pasbril bij een klant aan tafel" widths={[500, 900]} sizes="(min-width:1024px) 26vw, 60vw" loading="eager" class="col-span-3 aspect-[3/4] h-full w-full rounded-[18px] object-cover object-[40%_40%] lg:aspect-auto" />
            <div class="col-span-2 grid grid-rows-2 gap-4">
              <Image src={ePasglazen} alt="Kist met pasglazen" widths={[300, 600]} sizes="20vw" class="h-full min-h-0 w-full rounded-[18px] object-cover" />
              <div class="flex flex-col justify-end rounded-[18px] bg-merk p-4 text-wit"><p class="text-[clamp(1.5rem,2vw+.6rem,2.3rem)] font-[800] leading-none">Gratis</p><p class="mt-1 font-bold leading-tight">oogmeting en advies</p></div>
            </div>
          </div>
        </div>
      </section>
    )}

    {n === 3 && (
      /* 3. Rustig en donker met de sfeerfoto, plus een vertrouwenskaart met de harde punten. */
      <section class="relative isolate overflow-hidden bg-inkt text-wit lg:min-h-[100svh]" aria-labelledby="inhoud">
        <Image src={sHero} alt="" widths={[640, 1400, 2400]} sizes="100vw" loading="eager" class="absolute inset-0 -z-20 h-full w-full object-cover object-[70%_35%] opacity-90" />
        <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,#1d0a2ae6_0%,#1d0a2ab3_45%,#1d0a2af2_100%)] lg:bg-[linear-gradient(90deg,#1d0a2af7_0%,#1d0a2ad9_40%,#1d0a2a40_75%,#1d0a2a1a_100%)]"></div>
        <div class="wrap grid grid-cols-[minmax(0,1fr)] items-end gap-y-10 pb-16 pt-36 lg:min-h-[100svh] lg:grid-cols-12 lg:pb-20 lg:pt-48">
          <div class="lg:col-span-7">
            <p class="eyebrow eyebrow-licht">Opticien aan huis</p>
            <h1 id="inhoud" class="mt-4 text-[clamp(2.5rem,4.6vw+1rem,5rem)]">Rustig uw ogen laten meten, in uw eigen <span class="text-merk-licht">stoel.</span></h1>
            <p class="mt-6 max-w-xl text-xl leading-relaxed text-wit/90">Wij komen bij u thuis, of in het verzorgingshuis. Door midden en zuid Nederland.</p>
            <div class="mt-8 grid grid-cols-2 gap-3 sm:flex">
              <a href={site.telHref} class="knop knop-merk num !px-4 sm:!px-7"><Icoon naam="tel" /><span class="sm:hidden">Bellen</span><span class="hidden sm:inline">Bel {site.tel}</span></a>
              <a href="#afspraak" class="knop knop-wit !px-4 sm:!px-7"><Icoon naam="wa" />WhatsApp</a>
            </div>
          </div>
          <div class="rounded-[18px] bg-wit p-6 text-inkt shadow-[0_14px_40px_#00000040] sm:p-8 lg:col-span-5">
            <p class="flex items-center gap-2"><span class="flex text-merk">{sterren.map(() => <Icoon naam="ster" class="h-5 w-5" />)}</span><b class="num text-xl">5,0</b><span class="text-steen">uit 40 Google-reviews</span></p>
            <ul class="mt-5 space-y-3 border-t border-lijn-licht pt-5 text-lg">
              <li class="flex gap-3"><Icoon naam="vink" class="mt-1 h-5 w-5 flex-none text-merk" />Gediplomeerde opticien, met nascholing</li>
              <li class="flex gap-3"><Icoon naam="vink" class="mt-1 h-5 w-5 flex-none text-merk" />Oogmeting en advies kosteloos</li>
              <li class="flex gap-3"><Icoon naam="vink" class="mt-1 h-5 w-5 flex-none text-merk" />Factuur in te dienen bij uw zorgverzekering</li>
              <li class="flex gap-3"><Icoon naam="vink" class="mt-1 h-5 w-5 flex-none text-merk" />Partner van Aafje, Envida, Thebe en Meander</li>
            </ul>
          </div>
        </div>
      </section>
    )}

    {n === 4 && (
      /* 4. Gesplitst: links donker vlak met tekst en partnerlogo's, rechts de meting met de pasbril. */
      <section class="bg-inkt text-wit lg:grid lg:min-h-[100svh] lg:grid-cols-2" aria-labelledby="inhoud">
        <div class="relative h-[42svh] min-h-[18rem] lg:order-2 lg:h-auto">
          <Image src={eMeting} alt="De opticien meet met een pasbril bij een klant aan tafel" widths={[600, 1000, 1500]} sizes="(min-width:1024px) 50vw, 100vw" loading="eager" class="h-full w-full object-cover object-[45%_30%]" />
          <div class="absolute inset-x-0 top-0 h-32 bg-[linear-gradient(180deg,#1d0a2a,#1d0a2a00)] lg:h-48 lg:bg-[linear-gradient(180deg,#1d0a2af2_0%,#1d0a2ab3_45%,#1d0a2a00_100%)]"></div>
        </div>
        <div class="flex flex-col justify-end px-5 pb-14 pt-10 md:px-10 lg:order-1 lg:pb-20 lg:pl-[max(2.5rem,calc((100vw-80rem)/2+2.5rem))] lg:pr-14 lg:pt-48">
          <p class="eyebrow eyebrow-licht">Opticien aan huis</p>
          <h1 id="inhoud" class="mt-4 text-[clamp(2.5rem,3.6vw+1rem,4.4rem)]">Gemeten met een pasbril, net als bij de <span class="text-merk-licht">oogarts.</span></h1>
          <p class="mt-6 max-w-lg text-xl leading-relaxed text-wit/90">Door een gediplomeerde opticien, gewoon bij u thuis. Oogmeting en advies kosteloos.</p>
          <div class="mt-8 grid grid-cols-2 gap-3 sm:flex">
            <a href={site.telHref} class="knop knop-merk num !px-4 sm:!px-7"><Icoon naam="tel" /><span class="sm:hidden">Bellen</span><span class="hidden sm:inline">Bel {site.tel}</span></a>
            <a href="#afspraak" class="knop knop-wit !px-4 sm:!px-7"><Icoon naam="wa" />WhatsApp</a>
          </div>
          <p class="mt-10 font-bold text-mist">Officieel samenwerkingspartner van</p>
          <ul class="mt-4 grid grid-cols-4 gap-3">
            {partners.map((p) => <li class="grid h-16 place-items-center rounded-[12px] bg-wit p-2"><Image src={p.src} alt={p.alt} widths={[200]} sizes="100px" class="max-h-11 w-auto object-contain" /></li>)}
          </ul>
        </div>
      </section>
    )}

    {n === 5 && (
      /* 5. Het gereedschap komt mee: hun eigen foto's van pasglazen, pasbril en monturen als collage. */
      <section class="bg-papier-2 pb-16 pt-32 md:pt-44" aria-labelledby="inhoud">
        <div class="wrap">
          <div class="grid grid-cols-[minmax(0,1fr)] gap-y-8 lg:grid-cols-12 lg:items-end lg:gap-x-12">
            <div class="lg:col-span-7">
              <p class="eyebrow">Opticien aan huis</p>
              <h1 id="inhoud" class="mt-4 text-[clamp(2.5rem,4.4vw+1rem,4.8rem)]">Pasbril, pasglazen en monturen: wij nemen alles <span class="text-merk">mee.</span></h1>
            </div>
            <div class="lg:col-span-5">
              <p class="text-xl leading-relaxed text-steen">Een oogmeting en een nieuwe bril bij u thuis, door een gediplomeerde opticien. Oogmeting en advies kosteloos.</p>
              <div class="mt-6 grid grid-cols-2 gap-3 sm:flex">
                <a href={site.telHref} class="knop knop-merk num !px-4 sm:!px-7"><Icoon naam="tel" /><span class="sm:hidden">Bellen</span><span class="hidden sm:inline">Bel {site.tel}</span></a>
                <a href="#afspraak" class="knop knop-rand !px-4 sm:!px-7"><Icoon naam="wa" class="text-[#1a7f4b]" />WhatsApp</a>
              </div>
            </div>
          </div>
          <div class="mt-12 grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-12">
            <figure class="relative col-span-2 lg:col-span-6"><Image src={ePassen} alt="De opticien past bij een klant een montuur" widths={[600, 1000]} sizes="(min-width:1024px) 46vw, 100vw" loading="eager" class="aspect-[3/2] w-full rounded-[18px] object-cover object-[45%_30%] lg:h-full" /><figcaption class="absolute bottom-3 left-3 rounded-full bg-wit px-3 py-1 text-[.9375rem] font-bold">Passen aan uw eigen tafel</figcaption></figure>
            <figure class="relative lg:col-span-3"><Image src={ePasglazen} alt="Kist met pasglazen" widths={[400, 700]} sizes="(min-width:1024px) 22vw, 50vw" class="aspect-[3/4] w-full rounded-[18px] object-cover" /><figcaption class="absolute bottom-3 left-3 rounded-full bg-wit px-3 py-1 text-[.9375rem] font-bold">De pasglazen</figcaption></figure>
            <div class="grid gap-3 sm:gap-4 lg:col-span-3">
              <figure class="relative"><Image src={ePasbril} alt="De pasbril" widths={[500]} sizes="25vw" class="aspect-[4/3] w-full rounded-[18px] object-cover" /><figcaption class="absolute bottom-3 left-3 rounded-full bg-wit px-3 py-1 text-[.9375rem] font-bold">De pasbril</figcaption></figure>
              <div class="flex flex-col justify-between rounded-[18px] bg-inkt p-4 text-wit"><span class="flex text-merk-licht">{sterren.map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span><p class="mt-3"><b class="num text-3xl">5,0</b><span class="block text-mist">40 reviews op Google</span></p></div>
            </div>
          </div>
        </div>
      </section>
    )}

    {n === 6 && (
      /* 6. De letterkaart als hero, met ronde foto en de vertrouwenspunten ernaast. */
      <section class="bg-wit pb-16 pt-32 md:pt-44" aria-labelledby="inhoud">
        <div class="wrap grid grid-cols-[minmax(0,1fr)] items-center gap-y-12 lg:grid-cols-12 lg:gap-x-16">
          <div class="relative rounded-[22px] border border-lijn-licht bg-papier px-5 pb-10 pt-8 lg:col-span-6 lg:px-10">
            <p class="eyebrow text-center">Opticien aan huis</p>
            <h1 id="inhoud" class="mt-6 text-center font-[800] uppercase">
              <span class="block text-[clamp(3rem,6vw+.5rem,6rem)] leading-none tracking-[.04em]">Een</span>
              <span class="mt-3 block text-[clamp(2.1rem,4vw+.4rem,4rem)] leading-none tracking-[.08em]">nieuwe bril</span>
              <span class="mt-4 block text-[clamp(1.4rem,2.6vw+.3rem,2.6rem)] leading-none tracking-[.12em]">gewoon bij u</span>
              <span class="mt-4 block text-[clamp(2.3rem,4.4vw+.4rem,4.4rem)] leading-none tracking-[.1em] text-merk">thuis</span>
            </h1>
            <div class="mx-auto mt-8 h-[3px] w-24 bg-merk"></div>
            <Image src={ePassen} alt="De opticien past bij een klant thuis een montuur" widths={[300, 500]} sizes="160px" loading="eager" class="absolute -bottom-10 right-4 h-28 w-28 rounded-full border-4 border-wit object-cover object-[45%_25%] shadow-[0_8px_24px_#1d0a2a33] lg:h-40 lg:w-40" />
          </div>
          <div class="lg:col-span-6">
            <p class="text-xl leading-relaxed text-steen">Wij meten, net als de oogarts, met een pasbril. Door een gediplomeerde opticien, bij u thuis of in het verzorgingshuis.</p>
            <ul class="mt-6 space-y-3 text-lg">
              <li class="flex gap-3"><Icoon naam="vink" class="mt-1 h-5 w-5 flex-none text-merk" />Oogmeting en advies kosteloos</li>
              <li class="flex gap-3"><Icoon naam="polis" class="mt-1 h-5 w-5 flex-none text-merk" />Factuur in te dienen bij uw zorgverzekering</li>
              <li class="flex gap-3"><Icoon naam="ster" class="mt-1 h-5 w-5 flex-none text-merk" /><span><b class="num">5,0</b> op Google, 40 reviews</span></li>
            </ul>
            <div class="mt-8 grid grid-cols-2 gap-3 sm:flex">
              <a href={site.telHref} class="knop knop-merk num !px-4 sm:!px-7"><Icoon naam="tel" /><span class="sm:hidden">Bellen</span><span class="hidden sm:inline">Bel {site.tel}</span></a>
              <a href="#afspraak" class="knop knop-inkt !px-4 sm:!px-7"><Icoon naam="wa" />WhatsApp</a>
            </div>
          </div>
        </div>
      </section>
    )}
  </div>
</Base>
