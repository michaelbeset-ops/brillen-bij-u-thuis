---
// Drie mobiele hero-opties (13-10-2026). Bewaard buiten src/pages zodat het niet mee wordt gebouwd; om te bekijken tijdelijk terugzetten naar src/pages.
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icoon from '../components/Icoon.astro';
import Merk from '../components/Merk.astro';
import { site } from '../data/site';
import sHero from '../assets/s-hero.jpg';
import ePassen from '../assets/eigen-passen.jpg';
const sterren = [1, 2, 3, 4, 5];
const knoppen = (licht: boolean) => [licht];
---
<Base title="Hero-opties" description="Tijdelijk" noindex>
  <div class="flex flex-wrap items-start gap-10 bg-papier-3 p-10">

    <!-- OPTIE A: licht, foto als kaart -->
    <div id="a" class="w-[390px] min-h-[844px] overflow-hidden bg-papier">
      <div class="flex h-24 items-center justify-between px-5"><Merk donker /><span class="grid h-12 w-12 place-items-center rounded-full border-2 border-inkt/25 text-inkt"><svg viewBox="0 0 24 24" class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 8h16M4 16h16" /></svg></span></div>
      <div class="px-5 pb-10 pt-2">
        <p class="eyebrow">Opticien aan huis</p>
        <h1 class="mt-3 text-[2.6rem] leading-[1.02]">Een nieuwe bril, gewoon bij u <span class="text-merk">thuis.</span></h1>
        <div class="relative mt-6">
          <Image src={sHero} alt="" widths={[800]} sizes="350px" class="aspect-[4/3] w-full rounded-[18px] object-cover object-[62%_28%]" />
          <p class="absolute -bottom-5 right-4 flex items-center gap-2 rounded-full bg-wit px-4 py-2 text-[1rem] font-bold shadow-[0_6px_18px_#1d0a2a2e]"><span class="flex text-merk">{sterren.map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span><span class="num">5,0</span><span class="font-normal text-steen">op Google</span></p>
        </div>
        <p class="mt-9 text-xl leading-relaxed text-steen">Oogmeting en advies kosteloos, bij u thuis. Door midden en zuid Nederland.</p>
        <div class="mt-6 flex flex-col gap-3">
          <a class="knop knop-merk num"><Icoon naam="tel" />Bel {site.tel}</a>
          <a class="knop knop-rand"><Icoon naam="wa" class="text-[#1a7f4b]" />Afspraak via WhatsApp</a>
        </div>
      </div>
    </div>

    <!-- OPTIE B: tekst bovenaan op donker, eigen foto van Paul aan het werk eronder -->
    <div id="b" class="w-[390px] min-h-[844px] overflow-hidden bg-inkt text-wit">
      <div class="flex h-24 items-center justify-between px-5"><Merk /><span class="grid h-12 w-12 place-items-center rounded-full border-2 border-wit/40"><svg viewBox="0 0 24 24" class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 8h16M4 16h16" /></svg></span></div>
      <div class="px-5 pt-4">
        <p class="eyebrow eyebrow-licht">Opticien aan huis</p>
        <h1 class="mt-3 text-[2.6rem] leading-[1.02]">Wij komen naar u <span class="text-merk-licht">toe!</span></h1>
        <p class="mt-5 text-xl leading-relaxed text-wit/90">Oogmeting en een nieuwe bril, gewoon bij u thuis. Oogmeting en advies kosteloos.</p>
        <div class="mt-6 grid grid-cols-2 gap-3">
          <a class="knop knop-merk !px-3"><Icoon naam="tel" />Bellen</a>
          <a class="knop knop-wit !px-3"><Icoon naam="wa" />WhatsApp</a>
        </div>
      </div>
      <div class="relative mt-8">
        <Image src={ePassen} alt="" widths={[800]} sizes="390px" class="aspect-[4/3] w-full object-cover object-[50%_30%]" />
        <div class="absolute inset-x-0 top-0 h-16 bg-[linear-gradient(180deg,#1d0a2a,#1d0a2a00)]"></div>
        <p class="absolute bottom-4 left-5 flex items-center gap-2 rounded-full bg-wit px-4 py-2 text-[1rem] font-bold text-inkt"><span class="flex text-merk">{sterren.map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span><span class="num">5,0</span><span class="font-normal text-steen">40 reviews</span></p>
      </div>
    </div>

    <!-- OPTIE C: de letterkaart als hero, kleine ronde foto -->
    <div id="c" class="w-[390px] min-h-[844px] overflow-hidden bg-wit">
      <div class="flex h-24 items-center justify-between px-5"><Merk donker /><span class="grid h-12 w-12 place-items-center rounded-full border-2 border-inkt/25 text-inkt"><svg viewBox="0 0 24 24" class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 8h16M4 16h16" /></svg></span></div>
      <div class="px-5 pb-10">
        <div class="relative rounded-[18px] border border-lijn-licht bg-papier px-4 pb-8 pt-7">
          <p class="eyebrow text-center">Opticien aan huis</p>
          <h1 class="mt-5 text-center font-[800] uppercase">
            <span class="block text-[3.3rem] leading-none tracking-[.04em]">Een</span>
            <span class="mt-2 block text-[2.35rem] leading-none tracking-[.08em]">nieuwe bril</span>
            <span class="mt-3 block text-[1.6rem] leading-none tracking-[.12em]">gewoon bij u</span>
            <span class="mt-3 block text-[2.6rem] leading-none tracking-[.1em] text-merk">thuis</span>
          </h1>
          <div class="mx-auto mt-6 h-[3px] w-20 bg-merk"></div>
          <Image src={sHero} alt="" widths={[300]} sizes="120px" class="absolute -bottom-8 right-3 h-28 w-28 rounded-full border-4 border-wit object-cover object-[62%_25%] shadow-[0_6px_18px_#1d0a2a33]" />
        </div>
        <ul class="mt-12 space-y-2.5 text-lg">
          <li class="flex gap-3"><Icoon naam="vink" class="mt-1 h-5 w-5 flex-none text-merk" />Oogmeting en advies kosteloos</li>
          <li class="flex gap-3"><Icoon naam="ster" class="mt-1 h-5 w-5 flex-none text-merk" />5,0 op Google, 40 reviews</li>
        </ul>
        <div class="mt-7 flex flex-col gap-3">
          <a class="knop knop-merk num"><Icoon naam="tel" />Bel {site.tel}</a>
          <a class="knop knop-inkt"><Icoon naam="wa" />Afspraak via WhatsApp</a>
        </div>
      </div>
    </div>
  </div>
</Base>
