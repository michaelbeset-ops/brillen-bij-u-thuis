{
  "name": "brillen-bij-u-thuis",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --port 4504",
    "dev:voorstel": "node --env-file=.env.voorstel ./node_modules/astro/bin/astro.mjs dev --port 4504",
    "build": "astro build",
    "build:voorstel": "node --env-file=.env.voorstel ./node_modules/astro/bin/astro.mjs build",
    "preview": "astro preview --port 4504",
    "astro": "astro",
    "preview:voorstel": "node --env-file=.env.voorstel ./node_modules/astro/bin/astro.mjs preview --port 4504"
  },
  "allowScripts": {
    "esbuild": true
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/josefin-sans": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.5",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "sharp": "^0.35.5"
  }
}
